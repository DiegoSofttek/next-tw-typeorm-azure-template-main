# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
DATABASE_SERVER=localhost
DATABASE_NAME=myapp
DATABASE_USER=sa
DATABASE_PASSWORD=YourPassword123!
DATABASE_URL="sqlserver://localhost:1433;database=myapp;user=sa;password=YourPassword123!;encrypt=false;trustServerCertificate=true"

# Azure Storage (local)
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
AZURE_STORAGE_ACCOUNT_NAME=http://127.0.0.1:10000/devstoreaccount1 #Production would be like  https://devstoreaccount1.blob.core.windows.net

# Durable Functions
DURABLE_FUNCTIONS_URL=http://localhost:7071

# Azure Services (production)
AZURE_TENANT_ID=your-tenant-id
AZURE_SUBSCRIPTION_ID=your-subscription-id